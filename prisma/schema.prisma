// HCEDP Projects Tracker — system of record schema.
// All access goes through Prisma so the app stays portable across hosts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PipelineStage {
  RFI_RECEIVED
  PENDING_INFORMATION
  RFI_SUBMITTED
  SHORTLISTED
  SITE_VISIT
  IN_NEGOTIATIONS
  WON
  LOST
  NO_SUBMISSION
}

enum UserRole {
  ADMIN
  USER
  // External city-partner login. A PARTNER only ever sees the Placer AI request
  // area (submit + their city's requests); they are scoped to one PartnerCity and
  // never see the internal projects tracker. See src/lib/auth/session.ts.
  PARTNER
}

// The cities we have Placer AI reporting contracts with. A PARTNER user belongs
// to exactly one; every PlacerRequest is stamped with the submitter's city so
// each city only ever sees its own queue. Add a value here (and a label in
// src/lib/placer/schema.ts) when a new city comes on board.
enum PartnerCity {
  SAN_MARCOS
  BUDA
  LOCKHART
}

// What a city is asking us to measure with a Placer AI report.
enum PlacerReportType {
  EVENT_ATTENDANCE
  RESTAURANT_VISITORSHIP
  RETAIL_FOOT_TRAFFIC
  VISITOR_DEMOGRAPHICS
  LOCAL_BUSINESS_SUPPORT
  OTHER
}

// Position of a Placer AI request in the internal fulfillment queue. Drives the
// board columns on /placer. PLANNED sits ahead of the queue proper: a request a
// partner has told us is coming, parked on the planning calendar until its
// queueOnDate arrives (see releaseDuePlannedRequests in src/lib/placer/planning.ts),
// at which point it becomes SUBMITTED like any other. DECLINED is terminal and
// mirrors a "no submission": we chose not to fulfill it.
enum PlacerRequestStatus {
  PLANNED
  SUBMITTED
  IN_REVIEW
  IN_PROGRESS
  COMPLETED
  DECLINED
}

// How a recurring Placer plan repeats. QUARTERLY and ANNUAL are month-stepped
// variants of MONTHLY (3 and 12 months); WEEKLY steps in weeks. See
// src/lib/placer/recurrence.ts, which is the single implementation of the math.
enum PlacerRecurrence {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

// Whether a recurring plan lands on a fixed day of the month ("the 15th") or on
// an nth weekday ("the third Friday"). Ignored for WEEKLY, which always repeats
// on its own weekday.
enum PlacerRecurrenceMode {
  DAY_OF_MONTH
  NTH_WEEKDAY
}

// State of a ping (an assigned task). DONE is terminal but reversible — a task
// can be reopened, which clears completedAt.
enum TaskStatus {
  OPEN
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

// Why a user was notified. Every notification is in-app only (the bell in the
// top bar); nothing leaves the building. TASK_* concern pings, REQUEST_* concern
// Placer AI requests.
enum NotificationKind {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_COMPLETED
  REQUEST_ASSIGNED
  REQUEST_DUE_SOON
  REQUEST_OVERDUE
  REQUEST_RELEASED
}

// Stages of the pre-project leads pipeline. A lead is a prospect we are working
// before any RFI exists. CONVERTED and DEAD are terminal: CONVERTED is set by
// the convert-to-project action (never by hand), DEAD requires a reason.
enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DEAD
}

enum LeadSource {
  TEXAS_GOVERNORS_OFFICE // label: "Governor's Office"
  OPPORTUNITY_AUSTIN
  DIRECT_COMPANY
  DIRECT_REGIONAL_PARTNERS
  DIRECT_SITE_SELECTOR
  DIRECT_BROKER
  DIRECT_MARKETING_TRIP
  DIRECT_OTHER

  // Legacy values retained so this change is purely additive (Postgres cannot
  // drop an enum value that existing rows may still use, and the production
  // default used to be OTHER). They are NOT offered when creating/editing
  // records — see LEAD_SOURCE_LABELS — only preserved for existing rows. Remove
  // them in a later migration after remapping old rows (see
  // prisma/manual-migrations/2026-07-lead-source-expand.sql).
  DIRECT
  OTHER
}

// Tri-state site requirement: the company wants it, doesn't want it, or would
// prefer it but it isn't a hard requirement. Used for "existing building" and
// "rail" needs.
enum RequirementPreference {
  YES
  NO
  PREFERRED
}

enum UtilityType {
  ELECTRICITY
  WATER
  WASTEWATER
  GAS
}

// Status/outcome of an individual site submission within a project.
enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  SITE_VISIT
  WON
  LOST
  WITHDRAWN
}

// Real-estate classification of a site.
enum RealEstateType {
  INDUSTRIAL_GREENFIELD
  BROWNFIELD
  SPEC_INDUSTRIAL
  MIXED_USE
  OFFICE
}

// Whether a utility provider supplies electricity, water, sewer, or gas.
enum UtilityProviderType {
  ELECTRIC
  WATER
  SEWER
  GAS
}

// County in which a site is located.
enum County {
  HAYS
  CALDWELL
  TRAVIS
}

// ---------------------------------------------------------------------------
// Project — the spine of the system
// ---------------------------------------------------------------------------

model Project {
  id       String        @id @default(cuid())
  codename String
  stage    PipelineStage @default(RFI_RECEIVED)

  // Lead source / routing
  leadSource            LeadSource @default(DIRECT_OTHER)
  leadSourceOther       String?
  sourceContactName     String?
  sourceContactEmail    String?
  submissionDestination String?

  // Company location. Free text is captured exactly as entered (companyLocationRaw),
  // then normalized into structured parts so reports can group by state/country
  // (e.g. "all Illinois projects"). companyState holds the 2-letter USPS code for
  // US locations; companyCountry holds the normalized country name.
  companyLocationRaw String?
  companyCity        String?
  companyState       String?
  companyCountry     String?

  // Reason we chose not to submit a response (required when stage = NO_SUBMISSION).
  // Surfaced in the "no submission" reporting so we can analyze why we pass on RFIs.
  noSubmissionReason String? @db.Text

  // Industry / narrative
  naicsCode           String?
  // Derived 2-digit NAICS sector key for roll-up reporting (e.g. "31-33" for a
  // manufacturing code like 311111). Range sectors (31-33, 44-45, 48-49) collapse
  // to a single canonical key. Stored on write so reports/dashboards can group by
  // sector without re-deriving. See toNaicsSector() in src/lib/naics.ts.
  naicsSector         String?
  industryDescription String?
  narrative           String? @db.Text
  projectType         String? // expansion, new location, build-to-suit, ...

  // Capital investment (USD). Decimal keeps full precision for large figures.
  capexTotal     Decimal? @db.Decimal(18, 2)
  capexLand      Decimal? @db.Decimal(18, 2)
  capexBuilding  Decimal? @db.Decimal(18, 2)
  capexEquipment Decimal? @db.Decimal(18, 2)
  financingNotes String?  @db.Text
  hasFunding     Boolean?

  // Jobs. `jobs` is the single highest job count quoted in the RFI (RFI ingestion
  // no longer captures a phased breakdown — see jobPhases, retained for legacy
  // rows). Reports and the dashboard use `jobs`.
  jobs    Int?
  avgWage Decimal? @db.Decimal(14, 2)

  // Site requirements. Min is what reports use; max is captured when the RFI
  // states a range, for reference on the project page only.
  minAcreage                 Float?
  maxAcreage                 Float?
  minBuildingSqFt            Float?
  maxBuildingSqFt            Float?
  buildingSizeNeeds          String?                @db.Text
  siteLocationPreferences    String[] // e.g. Industrial Park, Freestanding Site, Incubator
  // Whether the company wants an existing building and whether rail service is
  // required (Yes / No / Preferred). Null = not specified in the RFI.
  existingBuildingPreference RequirementPreference?
  railPreference             RequirementPreference?

  // Utility requirements, captured verbatim as free text (one box per utility).
  // Replaces the normalized UtilityRequirement/UtilityDatapoint pipeline, which is
  // retained for historical rows but no longer written or shown.
  electricityNeeds String? @db.Text
  waterNeeds       String? @db.Text
  wastewaterNeeds  String? @db.Text
  gasNeeds         String? @db.Text

  // Notes
  environmentalNotes   String? @db.Text
  transportationNotes  String? @db.Text
  specialServicesNotes String? @db.Text

  // Required response deliverables (e.g. "Site Summary Spreadsheet", "Combined PDF")
  requiredDeliverables String[]

  // Dates
  rfiReceivedDate       DateTime?
  responseDueDate       DateTime?
  responseSubmittedDate DateTime?
  siteVisitDate         DateTime?
  projectedDecisionDate DateTime?
  productionStartDate   DateTime?

  // The single site chosen when this project was Won. Set via a prompt when the
  // project is moved to the WON stage; lets a won project roll up under exactly
  // one community in reports rather than every community we submitted a site in.
  wonSiteId String?
  wonSite   Site?   @relation("ProjectWonSite", fields: [wonSiteId], references: [id], onDelete: SetNull)

  // Original intake content
  rawEmailText String? @db.Text

  // Parser provenance + flags surfaced for human review.
  // parseWarnings: [{ field, message, kind: "assumption" | "conversion" | ... }]
  parsedModel   String?
  parsedAt      DateTime?
  parseWarnings Json?

  // Archived projects are hidden from the board and reports but remain in the
  // database, surfaced only via an explicit "archived" filter on the pipeline.
  archivedAt DateTime?

  // Soft delete. When set, the project is excluded from every list, report and
  // lookup, but the row (and its relations) are preserved so a delete can be
  // undone from the toast that appears immediately after. See src/lib/softDelete.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageHistory     ProjectStageEvent[]
  jobPhases        JobPhase[]
  utilities        UtilityRequirement[]
  criticalCriteria CriticalCriterion[]
  qualitativeNotes ProjectQualitativeNote[]
  attachments      Attachment[]
  submissions      Submission[]
  siteVisits       SiteVisit[]
  // Set when this project was created by converting a lead. Optional — most
  // projects arrive directly as an RFI with no preceding lead.
  lead             Lead?

  @@index([stage])
  @@index([naicsCode])
  @@index([naicsSector])
  @@index([rfiReceivedDate])
  @@index([archivedAt])
  @@index([deletedAt])
  @@index([companyState])
  @@index([companyCountry])
  @@index([wonSiteId])
}

// One recorded site visit for a project. A project can have several; each carries
// a date and an optional note (who attended / outcome). Powers the site-visit
// activity report (projects visited within a date range).
model SiteVisit {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // The submitted site this visit was to. Chosen from the project's submissions.
  // Optional for legacy rows created before per-site visit tracking.
  siteId     String?
  site       Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  visitDate  DateTime
  note       String?  @db.Text
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([siteId])
  @@index([visitDate])
}

// Timestamped record of every stage change, for win/loss progression reporting.
model ProjectStageEvent {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStage PipelineStage?
  toStage   PipelineStage
  note      String?
  changedAt DateTime       @default(now())

  @@index([projectId])
}

// Phased job counts with their timeframe (e.g. 75 in "Year One", 200 in "3-5 years").
model JobPhase {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  count      Int
  timeframe  String // free text as written in the RFI
  orderIndex Int     @default(0)

  @@index([projectId])
}

// Normalized utility requirement. Stores normalized value + the raw value as
// written + any time-phased datapoints. Conversions are flagged for review.
model UtilityRequirement {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      UtilityType

  normalizedValue Float? // in normalizedUnit
  normalizedUnit  String? // "MW", "thousand gal/day", "thousand ft3/day"
  rawValue        String? // exactly as written in the source

  purpose      String? @db.Text
  alternatives String? @db.Text // e.g. ULSD diesel / battery storage
  notes        String? @db.Text

  // Set when a value had to be converted/assumed during parsing.
  flagged        Boolean @default(false)
  assumptionNote String? @db.Text

  datapoints UtilityDatapoint[]

  @@index([projectId])
}

// A single dated datapoint within a utility requirement (e.g. a load-ramp step).
model UtilityDatapoint {
  id                   String             @id @default(cuid())
  utilityRequirementId String
  requirement          UtilityRequirement @relation(fields: [utilityRequirementId], references: [id], onDelete: Cascade)

  kind     String? // "day-one" | "peak" | "ramp" | "monthly" | ...
  label    String?
  value    Float?
  unit     String?
  date     DateTime?
  rawValue String?

  flagged        Boolean @default(false)
  assumptionNote String?

  @@index([utilityRequirementId])
}

// Ranked must-have criteria, in order of importance, that drive site selection.
// These become the Yes/No columns of the Site Summary deliverable.
model CriticalCriterion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rank      Int
  text      String  @db.Text

  @@index([projectId])
}

// Free-text qualitative needs that do not fit a structured field
// (e.g. "supportive educational ecosystem"). Queryable for the future
// Generate RFI Response feature.
model ProjectQualitativeNote {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  content   String  @db.Text

  @@index([projectId])
}

// Uploaded attachment, persisted via the storage abstraction.
model Attachment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String // opaque key returned by the storage driver
  kind       String   @default("attachment") // "attachment" | "rfi_email" | ...
  createdAt  DateTime @default(now())

  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Lead — the pre-project pipeline
// ---------------------------------------------------------------------------

// A prospect we are working before any RFI arrives. Deliberately a separate
// table from Project: the board, reports and submissions all query Project, and
// folding leads in would mean adding an "and not a lead" filter to every one of
// those queries. Field names mirror Project wherever they overlap so that
// convertToProject() is a straight copy rather than a translation layer.
model Lead {
  id String @id @default(cuid())

  // Optional: a lead often arrives as a company name with no codename yet, and
  // a codename is only assigned once it looks like a real project. At least one
  // of codename / companyName is required — enforced in the API, not the DB,
  // since Postgres check constraints are outside Prisma's schema language.
  codename String?
  stage    LeadStage @default(NEW)

  // The real company name, when we know it. Projects only carry a codename
  // because RFIs arrive anonymized; leads usually do not.
  companyName String?

  leadSource      LeadSource @default(DIRECT_OTHER)
  leadSourceOther String?

  contactName  String?
  contactEmail String?
  contactPhone String?

  // Same raw + normalized shape as Project, so conversion copies all four.
  companyLocationRaw String?
  companyCity        String?
  companyState       String?
  companyCountry     String?

  naicsCode           String?
  industryDescription String?

  // Early, uncommitted figures. Named "estimated" to distinguish them from the
  // Project fields they seed (capexTotal, jobPhases), which come from an RFI.
  estimatedCapex Decimal? @db.Decimal(18, 2)
  estimatedJobs  Int?

  minAcreage      Float?
  minBuildingSqFt Float?

  notes            String?   @db.Text
  nextFollowUpDate DateTime?

  // Required when stage = DEAD, mirroring Project.noSubmissionReason. Lets us
  // report on why leads die.
  deadReason String? @db.Text

  // Set only by the convert-to-project action. The lead is kept (stage
  // CONVERTED) rather than deleted so lead→project conversion stays reportable.
  convertedProjectId String?   @unique
  convertedProject   Project?  @relation(fields: [convertedProjectId], references: [id], onDelete: SetNull)
  convertedAt        DateTime?

  // Soft delete with the same restore-from-toast contract as Site and Project.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([deletedAt])
  @@index([nextFollowUpDate])
}

// ---------------------------------------------------------------------------
// Community / Site / Submission
// ---------------------------------------------------------------------------

// Fixed lookup, seeded in a specific order.
model Community {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int
  createdAt DateTime @default(now())

  sites Site[]

  @@index([order])
}

// Managed list of electricity and water utility providers. Editable in the UI
// (like communities) and usable as a site attribute and a report grouping.
model UtilityProvider {
  id        String              @id @default(cuid())
  name      String
  type      UtilityProviderType
  order     Int                 @default(0)
  createdAt DateTime            @default(now())

  electricForSites Site[] @relation("SiteElectricProvider")
  waterForSites    Site[] @relation("SiteWaterProvider")
  sewerForSites    Site[] @relation("SiteSewerProvider")
  gasForSites      Site[] @relation("SiteGasProvider")

  @@unique([type, name])
  @@index([type, order])
}

// A real estate site we can submit. Created manually through the UI.
model Site {
  id          String     @id @default(cuid())
  name        String
  // Community is optional: some sites fall outside any city's limits. Such sites
  // are grouped under "Outside city limits" in the UI and reports.
  communityId String?
  community   Community? @relation(fields: [communityId], references: [id])

  // Soft delete — hidden from the Sites catalog and new-submission pickers, but
  // the row is preserved so existing submissions still resolve and a delete can
  // be undone. See src/app/api/sites/[id].
  deletedAt DateTime?

  acreage    Float?
  address    String?
  notes      String? @db.Text
  attributes Json? // flexible bag for ad-hoc attributes

  realEstateType RealEstateType?

  // Electric capacity, in megawatts (MW).
  currentElectricMw   Float?
  projectedElectricMw Float?

  county       County?
  squareFeet   Float?
  pricePerSqFt Decimal? @db.Decimal(14, 2)

  electricProviderId String?
  electricProvider   UtilityProvider? @relation("SiteElectricProvider", fields: [electricProviderId], references: [id])
  waterProviderId    String?
  waterProvider      UtilityProvider? @relation("SiteWaterProvider", fields: [waterProviderId], references: [id])
  sewerProviderId    String?
  sewerProvider      UtilityProvider? @relation("SiteSewerProvider", fields: [sewerProviderId], references: [id])
  gasProviderId      String?
  gasProvider        UtilityProvider? @relation("SiteGasProvider", fields: [gasProviderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions    Submission[]
  siteVisits     SiteVisit[]
  // Projects for which this site was the chosen "won" site.
  wonForProjects Project[]    @relation("ProjectWonSite")

  @@index([communityId])
  @@index([deletedAt])
  @@index([electricProviderId])
  @@index([waterProviderId])
  @@index([sewerProviderId])
  @@index([gasProviderId])
}

// Link between a project and a site we submitted for it. Powers partner reports.
model Submission {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Restrict)

  submissionDate DateTime         @default(now())
  status         SubmissionStatus @default(SUBMITTED)
  outcomeNote    String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, siteId])
  @@index([projectId])
  @@index([siteId])
  @@index([submissionDate])
}

// ---------------------------------------------------------------------------
// Authentication — multi-user login with roles
// ---------------------------------------------------------------------------

// An application login. The bootstrap admin is upserted from the ADMIN_EMAIL /
// ADMIN_PASSWORD environment variables on startup; all other users are created
// in-app by an admin. Passwords are hashed with Node's scrypt (salt + hash
// stored together in passwordHash). General users have full app access except
// user management; admins additionally manage users.
model User {
  id                String       @id @default(cuid())
  email             String       @unique // stored lowercased
  name              String?
  passwordHash      String
  role              UserRole     @default(USER)
  // Set only for PARTNER users: the single city this external login is scoped to.
  // Required (in the API, not the DB) when role = PARTNER; always null for
  // internal ADMIN/USER logins.
  partnerCity       PartnerCity?
  // When set, the user can no longer log in and existing sessions are rejected.
  disabledAt        DateTime?
  // Version string of the most recent changelog entry this user has acknowledged
  // (see src/lib/changelog.ts). Null = has never dismissed the "What's new"
  // dialog, so they are shown every entry on their next visit. New users are
  // created already caught up to the current version so they don't get the whole
  // backlog on first login.
  lastSeenChangelog String?
  // Soft delete. When set, the login is hidden from the Users page and rejected
  // at sign-in, but the row is preserved so an accidental delete can be undone
  // from the toast that appears immediately after. Note: the email stays
  // reserved by the unique index while the row lingers soft-deleted.
  deletedAt         DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Who to auto-CC when this user archives a completed Placer AI request's
  // correspondence to the CRM (see PlacerRequest.archivedAt below) — e.g. two
  // staff who cover for each other. Set from the Users admin page; not
  // necessarily reciprocal in the data (each side is configured separately),
  // though in practice it is.
  ccPartnerId String?
  ccPartner   User?   @relation("UserCcPartner", fields: [ccPartnerId], references: [id], onDelete: SetNull)
  ccPartnerOf User[]  @relation("UserCcPartner")

  sessions Session[]

  // Placer AI requests this user submitted (partners) and is assigned to fulfil
  // (internal staff). Named relations because both point back to User.
  placerRequestsSubmitted PlacerRequest[] @relation("PlacerSubmittedBy")
  placerRequestsAssigned  PlacerRequest[] @relation("PlacerAssignedTo")

  // Recurring Placer plans this user set up / is the standing owner of.
  placerSeriesCreated  PlacerRequestSeries[] @relation("PlacerSeriesCreatedBy")
  placerSeriesAssigned PlacerRequestSeries[] @relation("PlacerSeriesAssignedTo")

  // Tasks assigned to this user, and tasks this user assigned to others.
  tasksAssigned Task[] @relation("TaskAssignedTo")
  tasksCreated  Task[] @relation("TaskCreatedBy")

  // In-app notifications addressed to this user (the bell in the top bar).
  notifications Notification[]

  @@index([email])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Placer AI requests — the city-partner reporting queue
// ---------------------------------------------------------------------------

// A request from a partner city for a Placer AI report (event attendance,
// restaurant visitorship, foot traffic, …). Deliberately its own table, parallel
// to Project: it has a distinct lifecycle (PlacerRequestStatus), a distinct
// audience (external partners submit, internal staff fulfil), and none of the
// RFI/site machinery. External partners only ever see rows matching their own
// city; internal staff see the whole queue on /placer.
model PlacerRequest {
  id   String      @id @default(cuid())
  // Which partner city this belongs to — stamped from the submitter's
  // User.partnerCity at creation, never chosen by hand, so a city can only ever
  // create requests for itself.
  city PartnerCity

  submittedById String
  submittedBy   User   @relation("PlacerSubmittedBy", fields: [submittedById], references: [id])

  // What / where to measure.
  placeName       String
  locationAddress String?
  reportType      PlacerReportType
  reportTypeOther String? // required (in the API) when reportType = OTHER

  // Timeframe to analyze. Start/end cover a range (a month, a quarter); a single
  // date uses start only. timeframeNote carries anything that doesn't fit dates
  // (e.g. "the two weekends of the festival").
  dateRangeStart DateTime?
  dateRangeEnd   DateTime?
  timeframeNote  String?

  // Why they need it / any specifics, plus when they need it by.
  purpose      String?   @db.Text
  neededByDate DateTime?

  // Internal fulfillment tracking.
  status        PlacerRequestStatus @default(SUBMITTED)
  assignedToId  String?
  assignedTo    User?               @relation("PlacerAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  // Staff-only working notes — never shown to the partner.
  internalNotes String?             @db.Text
  // Link to / summary of the delivered report. Shown to the partner once the
  // request is COMPLETED.
  resultNote    String?             @db.Text
  completedAt   DateTime?

  // Set once a completed request's correspondence has been emailed to the CRM
  // archive address (see ArchiveRequestDialog / POST
  // /api/placer-requests/[id]/archive). The contact is stamped here (not just
  // referenced via CrmContact) so this record reads correctly even if the
  // contact is later renamed or removed.
  archivedAt          DateTime?
  archiveContactName  String?
  archiveContactEmail String?

  // --- Planning -------------------------------------------------------------
  // A PLANNED request is one a partner has told us is coming. It sits on the
  // planning calendar (dateRangeStart is the event date) until queueOnDate, when
  // the release sweep flips it to SUBMITTED and stamps releasedAt. Both are null
  // on a request that arrived through the normal submit path.
  queueOnDate DateTime?
  releasedAt  DateTime?

  // Set when this row was generated from a recurring plan. occurrenceDate is the
  // date in the series that produced it; unique per series so re-running the
  // generator can never double-create an occurrence.
  seriesId       String?
  series         PlacerRequestSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  occurrenceDate DateTime?

  // Tasks and notifications that point at this request.
  tasks         Task[]
  notifications Notification[]

  // Soft delete with the same restore-from-toast contract as Project/Lead/Site.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([seriesId, occurrenceDate])
  @@index([city])
  @@index([status])
  @@index([assignedToId])
  @@index([submittedById])
  @@index([deletedAt])
  @@index([queueOnDate])
  @@index([dateRangeStart])
}

// A server-side session. The browser only holds a signed cookie carrying the
// session id; validity, expiry, and revocation are checked against this table.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Placer AI planning — recurring plans
// ---------------------------------------------------------------------------

// A standing, repeating Placer AI report ("downtown foot traffic, the third
// Friday of every month"). The series is the template; the calendar and the
// queue only ever deal in the PLANNED PlacerRequest rows it materializes, so a
// generated occurrence can be edited, moved or deleted on its own without
// disturbing the pattern. See src/lib/placer/recurrence.ts for the date math and
// materializeSeries() in src/lib/placer/planning.ts for the generator.
model PlacerRequestSeries {
  id   String      @id @default(cuid())
  city PartnerCity

  // What each occurrence asks for — copied onto every generated request.
  placeName       String
  locationAddress String?
  reportType      PlacerReportType
  reportTypeOther String?
  purpose         String?          @db.Text

  // The pattern. interval is "every N" of the unit implied by frequency (so
  // QUARTERLY with interval 1 is every 3 months). dayOfMonth is used in
  // DAY_OF_MONTH mode (clamped to short months); weekday + weekOfMonth in
  // NTH_WEEKDAY mode (weekOfMonth -1 = last). WEEKLY ignores mode and repeats on
  // startDate's weekday.
  frequency   PlacerRecurrence
  interval    Int                  @default(1)
  mode        PlacerRecurrenceMode @default(DAY_OF_MONTH)
  dayOfMonth  Int?
  weekday     Int? // 0 = Sunday … 6 = Saturday
  weekOfMonth Int? // 1–4, or -1 for "last"

  // Window the pattern runs over. startDate is also the anchor the month/week
  // stepping counts from. endDate is optional ("forever").
  startDate DateTime
  endDate   DateTime?

  // Days after the occurrence (the event) before the request should hit the
  // queue — Placer data is typically available about a week later.
  leadDays Int @default(7)

  // Standing owner: every generated occurrence is assigned to them, and they are
  // pinged when it drops into the queue.
  assignedToId String?
  assignedTo   User?   @relation("PlacerSeriesAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("PlacerSeriesCreatedBy", fields: [createdById], references: [id])

  // Paused series stop generating new occurrences; already-generated ones stay.
  active           Boolean   @default(true)
  // How far ahead occurrences have been materialized, so the generator only ever
  // walks forward.
  generatedThrough DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  requests PlacerRequest[]

  @@index([city])
  @@index([active])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Tasks and in-app notifications
// ---------------------------------------------------------------------------

// A task: a piece of work assigned to one internal user, optionally with a due
// date and optionally attached to a Placer AI request. Assigning one notifies
// the assignee immediately; the reminder sweep notifies them again as the due
// date approaches and once it passes (see src/lib/notifications/notify.ts).
model Task {
  id      String  @id @default(cuid())
  title   String
  details String? @db.Text

  dueDate     DateTime?
  status      TaskStatus   @default(OPEN)
  priority    TaskPriority @default(NORMAL)
  completedAt DateTime?

  assignedToId String
  assignedTo   User   @relation("TaskAssignedTo", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  // Optional subject: the Placer request this task is about. Deleting the
  // request leaves the task standing but unlinked.
  placerRequestId String?
  placerRequest   PlacerRequest? @relation(fields: [placerRequestId], references: [id], onDelete: SetNull)

  notifications Notification[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([assignedToId, status])
  @@index([createdById])
  @@index([dueDate])
  @@index([placerRequestId])
  @@index([deletedAt])
}

// A CRM contact remembered from past "Archive to CRM" sends (see
// PlacerRequest.archivedAt), so the dialog can suggest the small, recurring set
// of requestors staff correspond with instead of retyping the same name/email
// every time. Global (not per-user) since the same handful of contacts are
// shared across staff.
model CrmContact {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  useCount   Int      @default(1)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([lastUsedAt])
}

// One in-app notification for one user. Written by the assignment paths and by
// the reminder sweep; read by the bell in the top bar. Deliberately denormal-
// ized (title/body/href are stamped at write time) so the bell renders from one
// cheap query and a notification still reads correctly after its subject changes.
model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   NotificationKind

  title String
  body  String?
  /// Where clicking the notification goes, e.g. "/tasks" or "/placer/<id>".
  href  String?

  // What it is about. Both are optional and both are cleared (SetNull) if the
  // subject is hard-deleted; the stamped title/body keep the entry readable.
  taskId          String?
  task            Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  placerRequestId String?
  placerRequest   PlacerRequest? @relation(fields: [placerRequestId], references: [id], onDelete: SetNull)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([kind, taskId])
  @@index([kind, placerRequestId])
}
